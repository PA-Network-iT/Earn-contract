# Network / شبکه
RPC_URL=

DEPLOYER_PRIVATE_KEY=

# Earn deployment params / پارامترهای deploy پروتکل EARN
# Temporary test wallet — replace later / والت موقت تست — بعداً عوض شود
EARN_ADMIN=0xecEBb9929F28e3793aa8c52463D658Ce01c21A9d
EARN_ASSET=0x9A4266489BaA77DaF89C558d483E386FE83bA469
EARN_TREASURY_WALLET=0xecEBb9929F28e3793aa8c52463D658Ce01c21A9d

# Mock token deployment (optional) / دیپلوی توکن mock (اختیاری)
# Example / مثال: 1000000 USDC (6 decimals / ۶ رقم اعشار) => 1000000000000
MOCK_USDC_MINT_TO=0xecEBb9929F28e3793aa8c52463D658Ce01c21A9d
MOCK_USDC_MINT_AMOUNT=1000000000000

# Earn proxy address (set after deployment) / آدرس پراکسی EARN پس از deploy
EARN_PROXY=0x0000000000000000000000000000000000000000

# Share token address (set after DeployEarnShareToken) / آدرس share token پس از DeployEarnShareToken
EARN_SHARE_TOKEN=0x0000000000000000000000000000000000000000

# Use the default-admin signer for BindShareToken when admin is an EOA.
# If admin is a multisig/timelock, submit setShareToken(address) through that admin instead.
# اگر admin یک EOA است، برای BindShareToken از signer همان default-admin استفاده کنید.
# اگر admin یک multisig یا timelock است، setShareToken(address) را از طریق همان admin submit کنید.
BIND_SHARE_TOKEN_PRIVATE_KEY=

# Use the default-admin signer for ConfigureRoles when admin is an EOA.
# If admin is a multisig/timelock, grant roles through that admin instead.
# اگر admin یک EOA است، برای ConfigureRoles از signer همان default-admin استفاده کنید.
# اگر admin یک multisig یا timelock است، نقش‌ها را از طریق همان admin اعطا کنید.
CONFIGURE_ROLES_PRIVATE_KEY=

# Optional role split (use same address as EARN_ADMIN if no split)
# تفکیک اختیاری نقش‌ها (اگر تفکیک ندارید از همان آدرس EARN_ADMIN استفاده کنید)
ROLE_PARAMETER_MANAGER=0xecEBb9929F28e3793aa8c52463D658Ce01c21A9d
ROLE_TREASURY_MANAGER=0xecEBb9929F28e3793aa8c52463D658Ce01c21A9d
ROLE_COMPLIANCE=0xecEBb9929F28e3793aa8c52463D658Ce01c21A9d
ROLE_REPORTER=0xecEBb9929F28e3793aa8c52463D658Ce01c21A9d
ROLE_PAUSER=0xecEBb9929F28e3793aa8c52463D658Ce01c21A9d
ROLE_UPGRADER=0xecEBb9929F28e3793aa8c52463D658Ce01c21A9d

# Subscription suite / مجموعه اشتراک
SUBSCRIPTION_ADMIN=0xecEBb9929F28e3793aa8c52463D658Ce01c21A9d
SUBSCRIPTION_PRICE=50000000
SUBSCRIPTION_SET_MANAGER=true
SUBSCRIPTION_MANAGER=0x0000000000000000000000000000000000000000
SUBSCRIPTION_MINT_GENESIS=false
SUBSCRIPTION_GENESIS_USER=0xecEBb9929F28e3793aa8c52463D658Ce01c21A9d
EARN_ADMIN_PRIVATE_KEY=

# Timelocked upgrade flow (script/upgrade) / جریان ارتقای زمان‌قفل‌شده
# 1) DeployImplementations -> 2) ScheduleUpgrade -> wait UPGRADE_DELAY (24h) -> 3) ExecuteUpgrade
UPGRADER_PRIVATE_KEY=
UPGRADE_PROXY=0x0000000000000000000000000000000000000000
UPGRADE_IMPLEMENTATION=0x0000000000000000000000000000000000000000
# Optional post-upgrade call (hex calldata), leave empty for none
UPGRADE_CALLDATA=

# Two-step treasury wallet rotation (script/treasury) / تغییر دو مرحله‌ای کیف پول خزانه
# ProposeTreasuryWallet -> wait TREASURY_WALLET_CHANGE_DELAY (24h) -> AcceptTreasuryWallet
TREASURY_ADMIN_PRIVATE_KEY=
# EarnCore or SubscriptionManager proxy / پراکسی EarnCore یا SubscriptionManager
TREASURY_TARGET=0x0000000000000000000000000000000000000000

ETHERSCAN_API_KEY=
